:80 {
  encode zstd gzip

  root * /usr/share/caddy

  route {
    @api path /api/*
    reverse_proxy @api backend:{$API_PORT}

    @assets path /assets/*
    handle @assets {
      header Cache-Control "public, max-age=31536000, immutable"
      file_server
    }

    handle {
      try_files {path} /index.html
      header Cache-Control "no-cache, no-store, must-revalidate"
      file_server
    }
  }
}
