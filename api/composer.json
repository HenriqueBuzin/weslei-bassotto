{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "wesleibassotto/api",
    "type": "project",
    "description": "API Laravel da plataforma Weslei Bassotto",
    "license": "MIT",
    "require": {
        "php": "8.5.9",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-sodium": "*",
        "firebase/php-jwt": "7.1.0",
        "laravel/framework": "13.24.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "1.30.4",
        "mockery/mockery": "1.6.12",
        "nunomaduro/collision": "8.9.5",
        "phpunit/phpunit": "12.5.33"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "php -d memory_limit=1G vendor/bin/phpstan analyse --no-progress",
        "test": "phpunit",
        "test:coverage": [
            "php -d memory_limit=2G vendor/bin/phpunit --coverage-clover=coverage/clover.xml --coverage-filter app",
            "php scripts/coverage-gate.php"
        ],
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test:api": "phpunit --testsuite api",
        "test:functional": "phpunit --testsuite functional",
        "test:regression": "phpunit --testsuite regression",
        "test:smoke": "phpunit --testsuite smoke",
        "gates": [
            "@lint",
            "@analyse",
            "@test:coverage"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.5.9",
            "ext-pdo_pgsql": "8.5.9"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "gates": "Roda formatação, análise estática e cobertura com piso de 100% de linhas."
    }
}
