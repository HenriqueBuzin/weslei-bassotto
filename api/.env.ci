# Ambiente mínimo para as portas de qualidade rodarem fora de um deploy.
#
# Larastan e os comandos artisan sobem a aplicação, e o AppServiceProvider valida
# a configuração na subida. Sem estes valores, `phpstan` e o
# `package:discover` do composer falham com "DATABASE_URL is required".
#
# Todos os valores são falsos de propósito e nada aqui se conecta a nada: os
# testes usam SQLite em memória e o gateway de pagamento é sempre um fake.
# Este arquivo é passado por `--env-file`, nunca copiado sobre um `.env` real.

APP_ENV=dev
APP_KEY=base64:Q0lPTkxZRkFLRUtFWUZPUlNUQVRJQ0FOQUxZU0lTMDA=
APP_URL=http://localhost:8000
API_BASE=/api/v1
API_PORT=8000

DB_CONNECTION=sqlite
DATABASE_URL=postgresql://ci:ci@127.0.0.1:5432/ci

JWT_SECRET=ci-only-secret-that-is-long-enough-for-hs256-validation
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_SHORT_HOURS=8
REFRESH_TOKEN_EXPIRES_LONG_DAYS=30

LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

SEED_ON_START=false

CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REFRESH_COOKIE_NAME=rt
REFRESH_COOKIE_PATH=/api/v1/auth

PAYMENT_GATEWAY_ORDER=mercado_pago
MERCADO_PAGO_ACCESS_TOKEN=ci-fake-token
MERCADO_PAGO_WEBHOOK_SECRET=ci-fake-webhook-secret

PASSWORD_RESET_EXPIRES_MINUTES=30

MAIL_MAILER=array
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=ci@example.com
SMTP_PASSWORD=ci-fake-password
SMTP_FROM=ci@example.com
