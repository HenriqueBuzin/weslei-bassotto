# Contrato real desta API. Em dev e prod estes valores chegam pelo compose, a
# partir de ~/projects/envs/weslei-bassotto{,-dev}.env na VPS; os marcados como
# secret entram por Docker secret e são lidos via <NOME>_FILE.

# --------------------------------------------------
# Aplicação
# --------------------------------------------------
APP_ENV=dev
# secret. Gere com: php artisan key:generate --show
APP_KEY=
# Base dos links que a API monta, como o de redefinição de senha.
APP_URL=http://localhost:8000
# O compose repassa este valor ao frontend como VITE_API_BASE, então a base
# aparece uma única vez no env.
API_BASE=/api/v1
API_PORT=8000

# --------------------------------------------------
# Banco de dados
# --------------------------------------------------
# secret
DATABASE_URL=postgresql://usuario:senha@postgres:5432/weslei_bassotto

# --------------------------------------------------
# Autenticação e JWT
# --------------------------------------------------
# secret. HS256 exige 32+ caracteres.
JWT_SECRET=
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_SHORT_HOURS=8
REFRESH_TOKEN_EXPIRES_LONG_DAYS=30

LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# --------------------------------------------------
# Administradores
# --------------------------------------------------
# Só roda com o banco vazio. Os admins nascem com senha placeholder e
# must_change_password, então a senha real é definida no primeiro acesso —
# nenhuma senha de admin vive no ENV.
SEED_ON_START=true

# --------------------------------------------------
# CORS e cookies
# --------------------------------------------------
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REFRESH_COOKIE_NAME=rt
REFRESH_COOKIE_PATH=/api/v1/auth

# --------------------------------------------------
# Pagamentos
# --------------------------------------------------
PAYMENT_GATEWAY_ORDER=mercado_pago
# secret
MERCADO_PAGO_ACCESS_TOKEN=
# secret
MERCADO_PAGO_WEBHOOK_SECRET=

# --------------------------------------------------
# Recuperação de senha por e-mail
# --------------------------------------------------
PASSWORD_RESET_EXPIRES_MINUTES=30

MAIL_MAILER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=
# secret
SMTP_PASSWORD=
SMTP_FROM=
