{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "type": "module",
  "engines": {
    "node": "24.18.1",
    "npm": "11.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --maxWorkers=1",
    "test:unit": "vitest run src/lib/date.test.ts src/lib/errors.test.ts src/lib/jwt.test.ts src/routes/paths.test.ts src/hooks src/context --maxWorkers=1",
    "test:integration": "vitest run src/pages/admin/Dashboard.integration.test.tsx src/pages/user/Questionnaire.integration.test.tsx src/pages/user/SubscriberArea.integration.test.tsx --maxWorkers=1",
    "test:functional": "vitest run src/pages/Login.test.tsx src/pages/Register.test.tsx src/pages/PasswordFlows.test.tsx src/pages/user/CheckoutBrick.test.tsx --maxWorkers=1",
    "test:regression": "vitest run src/auth src/pages/PasswordErrors.test.tsx src/pages/user/CheckoutBrick.env.test.tsx src/pages/user/Home.env.test.tsx --maxWorkers=1",
    "test:smoke": "vitest run src/pages/user/Home.test.tsx src/pages/NotFound.test.tsx src/pages/NotAuthorized.test.tsx src/routes/index.test.tsx --maxWorkers=1",
    "test:api": "vitest run src/lib/api.test.ts --maxWorkers=1",
    "test:e2e": "node scripts/run-e2e.mts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"scripts/**/*.mts\" \"*.ts\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"scripts/**/*.mts\" \"*.ts\" \"*.json\"",
    "gates": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "axios": "1.18.1",
    "bootstrap": "5.3.8",
    "jwt-decode": "4.0.0",
    "prop-types": "15.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "jiti": "2.7.0",
    "jsdom": "30.0.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
