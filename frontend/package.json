{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --maxWorkers=1",
    "test:unit": "vitest run src/lib/date.test.js src/lib/jwt.test.js src/hooks src/context --maxWorkers=1",
    "test:integration": "vitest run src/pages/admin/Dashboard.integration.test.jsx src/pages/user/Questionnaire.integration.test.jsx src/pages/user/SubscriberArea.integration.test.jsx --maxWorkers=1",
    "test:functional": "vitest run src/pages/Login.test.jsx src/pages/Register.test.jsx src/pages/PasswordFlows.test.jsx src/pages/user/CheckoutBrick.test.jsx --maxWorkers=1",
    "test:regression": "vitest run src/auth src/pages/PasswordErrors.test.jsx src/pages/user/CheckoutBrick.env.test.jsx src/pages/user/Home.env.test.jsx --maxWorkers=1",
    "test:smoke": "vitest run src/pages/user/Home.test.jsx src/pages/NotFound.test.jsx src/routes/index.test.jsx --maxWorkers=1",
    "test:api": "vitest run src/lib/api.test.js --maxWorkers=1",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"e2e/**/*.js\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"e2e/**/*.js\" \"*.js\""
  },
  "dependencies": {
    "axios": "1.18.1",
    "bootstrap": "5.3.8",
    "jwt-decode": "4.0.0",
    "prop-types": "15.8.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
