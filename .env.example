ENV_FILE=.env
# Use weslei-bassotto-dev ou weslei-bassotto-prod quando os dois ambientes
# rodarem simultaneamente. O Jenkins define esse valor por branch.
COMPOSE_PROJECT_NAME=weslei-bassotto-dev
API_PORT=8000
VITE_PORT=5173
API_BASE=/api/v1
APP_ENV=dev
DB_ADAPTER=postgres
# Preencha somente a conexao do adapter selecionado; a outra deve ficar vazia.
# Compartilhe o servidor/rede, nunca o banco ou usuario entre dev e producao.
DATABASE_URL=postgresql://weslei_dev:change-me@postgres:5432/weslei_bassotto_dev
DATABASE_POOL_SIZE=5
POSTGRES_NETWORK=postgres-network
JWT_SECRET=
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_SHORT_HOURS=8
REFRESH_TOKEN_EXPIRES_LONG_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
CORS_ALLOWED_ORIGINS=["http://localhost:8080","http://localhost:5173"]
# Para trocar para Mongo: use DB_ADAPTER=mongo, deixe DATABASE_URL= e preencha
# MONGO_URI. A aplicacao recusa a inicializacao se as duas conexoes estiverem ativas.
MONGO_URI=
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REFRESH_COOKIE_NAME=rt
REFRESH_COOKIE_PATH=/api/v1/auth
SEED_ON_START=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ACCOUNTS=[{"email":"admin1@example.com","password":"troque-esta-senha"},{"email":"admin2@example.com","password":"troque-esta-senha"}]
VITE_API_BASE=/api/v1
VITE_APP_NAME=Weslei Bassotto
VITE_MP_PUBLIC_KEY=
VITE_MP_TRIMESTRAL_URL=
VITE_MP_SEMESTRAL_URL=
VITE_MP_ANUAL_URL=
VITE_WHATSAPP_NUMBER=5554991126308
VITE_HMR_DISABLED=false
VITE_HMR_HOST=
VITE_HMR_PROTOCOL=wss
VITE_HMR_CLIENT_PORT=443
VITE_HMR_PATH=/__vite_hmr
PAYMENT_GATEWAY_ORDER=mercado_pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
APP_PUBLIC_URL=http://localhost:8080
FRONTEND_PUBLIC_URL=http://localhost:8080
PASSWORD_RESET_EXPIRES_MINUTES=30
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CADDY_DOMAIN=localhost
CADDY_EMAIL=
