# Configuracao comum. Segredos ficam em arquivos separados dentro de
# SECRETS_DIR e entram nos containers por Docker Compose Secrets.
API_PORT=8000
VITE_PORT=5173
API_BASE=/api/v1
APP_ENV=dev
APP_URL=http://localhost:5173

# Cada ambiente usa seu proprio diretorio e banco PostgreSQL.
POSTGRES_NETWORK=postgres-network
SECRETS_DIR=./secrets

JWT_ALG=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_SHORT_HOURS=8
REFRESH_TOKEN_EXPIRES_LONG_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REFRESH_COOKIE_NAME=rt
REFRESH_COOKIE_PATH=/api/v1/auth
SEED_ON_START=true

# VITE_API_BASE atende tambem a execucao direta de npm run dev fora do Compose.
VITE_API_BASE=/api/v1
VITE_APP_NAME=Weslei Bassotto
VITE_MP_PUBLIC_KEY=
VITE_WHATSAPP_NUMBER=5554991126308
VITE_HMR_DISABLED=false
VITE_HMR_HOST=
VITE_HMR_PROTOCOL=wss
VITE_HMR_CLIENT_PORT=443
VITE_HMR_PATH=/__vite_hmr

PAYMENT_GATEWAY_ORDER=mercado_pago
PASSWORD_RESET_EXPIRES_MINUTES=30

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=
SMTP_FROM=
